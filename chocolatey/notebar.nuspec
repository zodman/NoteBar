<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
    <metadata>
        <id>notebar</id>
        <title>NoteBar</title>
        <version>1.1.0</version>
        <owners>zodman</owners>
        <authors>Pavel Stefanov, zodman</authors>
        <licenseUrl>https://github.com/zodman/NoteBar/blob/master/LICENSE</licenseUrl>
        <projectUrl>https://github.com/zodman/NoteBar</projectUrl>
        <packageSourceUrl>https://github.com/zodman/NoteBar</packageSourceUrl>
        <projectSourceUrl>https://github.com/zodman/NoteBar</projectSourceUrl>
        <requireLicenseAcceptance>false</requireLicenseAcceptance>
        <tags>notebar anybar taskbar systemtray indicator status windows11 dot</tags>
        <description>NoteBar is a status indicator for Windows 11 and Windows 10 that displays colored dots or custom icons, controllable via UDP and CLI. It is a modernized .NET 8 Windows clone of AnyBar.</description>
        <summary>Windows 11 &amp; Windows 10 taskbar and system tray status indicators</summary>
    </metadata>
    <files>
        <file src="tools\**" target="tools" />
    </files>
</package>
